{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Switch",
  "version": "0.1.0",
  "identifier": "com.codexswitch.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codex Switch",
        "width": 365,
        "height": 740,
        "minWidth": 365,
        "minHeight": 740,
        "maxWidth": 365,
        "maxHeight": 740,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/codex-switch.ico"]
  }
}
